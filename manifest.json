{
  "manifest_version": 3,
  "name": "Z.ai CopyCode \u2014 Copy Button for Code Blocks",
  "version": "1.3",
  "description": "Adds a one-click copy button to code blocks and editors on z.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "CopyCode"
  },
  "content_scripts": [
    {
      "matches": [
        "https://z.ai/*",
        "https://*.z.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}