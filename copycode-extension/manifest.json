{
  "manifest_version": 3,
  "name": "CopyCode — One-Click Copy for Code Blocks",
  "version": "1.3",
  "description": "Adds a copy button to real code blocks (pre and CodeMirror) on any website.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }, "default_title": "CopyCode" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
